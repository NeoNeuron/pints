rules_version = '2';

// The ONLY authorization boundary for this site. The client is a static page on
// GitHub Pages with no server in front of it, so anything not forbidden here is
// permitted to anyone on the internet holding the (public) Firebase config.
//
// Two constraints shape everything below:
//
//  1. Rules cannot filter fields. A read is all-or-nothing per document, so
//     every "public but partial" view is a separate projection collection
//     (participants_public, abstracts_public) rather than a field-level rule.
//  2. Public list pages need `allow read: if true` — that is get AND list.
//     A get-only rule denies the collection queries those pages issue.

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() { return request.auth != null; }

    function isOwner(uid) { return isSignedIn() && request.auth.uid == uid; }

    function isVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isAdmin() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function str(value, maxLen) {
      return value is string && value.size() > 0 && value.size() <= maxLen;
    }

    function optStr(data, field, maxLen) {
      return !(field in data)
        || (data[field] is string && data[field].size() <= maxLen);
    }

    // Reads config/site. If that document is missing the get() errors and the
    // rule fails closed, which is the behaviour we want.
    function submissionWindowOpen() {
      let cfg = get(/databases/$(database)/documents/config/site).data;
      return cfg.submissionsOpen == true && request.time < cfg.submissionDeadline;
    }

    // The figure and its caption are REQUIRED: a poster abstract without one is
    // not usable in the booklet, and a figure nobody captioned is not usable
    // either. Organizers writing through `allow write: if isAdmin()` skip this,
    // so a record that predates the rule can still be repaired.
    function validAbstract(data, uid) {
      return data.keys().hasOnly(['ownerUid', 'edition', 'title', 'affiliations', 'authors',
                                  'body', 'topic', 'talkConsidered', 'figureUrl', 'figurePath',
                                  'figureCaption', 'status', 'createdAt', 'updatedAt'])
        && data.keys().hasAll(['ownerUid', 'edition', 'title', 'affiliations', 'authors',
                               'body', 'topic', 'talkConsidered', 'figureUrl',
                               'figureCaption', 'status'])
        && data.ownerUid == uid
        && data.edition is string
        && str(data.title, 200)
        && str(data.body, 2500)
        && data.topic in ['cognitive', 'systems', 'computational']
        && data.talkConsidered is bool
        && str(data.figureUrl, 500)
        && str(data.figureCaption, 300)
        && (!('figurePath' in data) || data.figurePath == null || str(data.figurePath, 300))
        && data.authors is list && data.authors.size() > 0 && data.authors.size() <= 20
        && data.affiliations is list && data.affiliations.size() <= 10;
    }

    // PINTS is a single day in a single venue, so there is no day, no room, and
    // no manual rank: `start` is the whole ordering.
    function validScheduleItem(data) {
      return data.keys().hasOnly(['edition', 'start', 'end', 'title', 'speaker',
                                  'affiliation', 'kind', 'session', 'abstractId'])
        && data.keys().hasAll(['edition', 'title', 'kind'])
        && data.edition is string
        && str(data.title, 200)
        && data.kind in ['keynote', 'talk', 'poster', 'break', 'lunch', 'social', 'other']
        // Optional: coffee, lunch and the poster slot belong to no session. The
        // vocabulary matches ABSTRACT_TOPICS plus the invited block, because a
        // session is what a topic becomes once it is scheduled.
        && (!('session' in data)
            || data.session in ['cognitive', 'systems', 'computational', 'keynote']);
    }

    function validProfile(data) {
      return data.keys().hasOnly(['email', 'displayName', 'affiliation', 'showPublicly',
                                  'edition', 'consentAt', 'createdAt', 'updatedAt'])
        && data.keys().hasAll(['email', 'displayName', 'edition'])
        && str(data.displayName, 80)
        && optStr(data, 'affiliation', 120)
        && data.edition is string
        && (!('showPublicly' in data) || data.showPublicly is bool);
    }

    // Site configuration: submission window and current edition. Public read so
    // every page can show the deadline; admin write only.
    match /config/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Admin registry. A user may read their OWN document so the client knows
    // whether to show admin UI; only admins may list or write. Membership of
    // this collection is what isAdmin() tests, so write access is the keys to
    // the kingdom — never widen it.
    match /admins/{uid} {
      allow get: if isOwner(uid) || isAdmin();
      allow list: if isAdmin();
      allow write: if isAdmin();
    }

    // Private participant profile. Never public — see participants_public.
    match /users/{uid} {
      allow get: if isOwner(uid) || isAdmin();
      allow list: if isAdmin();
      allow create: if isOwner(uid)
        && validProfile(request.resource.data)
        && request.resource.data.email == request.auth.token.email;
      allow update: if isOwner(uid)
        && validProfile(request.resource.data)
        && request.resource.data.email == resource.data.email;
      allow delete: if isOwner(uid);
      allow write: if isAdmin();
    }

    // Public projection of a participant's name, written by the participant
    // themselves as part of registering. There is no opt-out: account.html says
    // plainly that registering puts you on the list.
    //
    // Organizers may write it too, so the admin console can correct a name or an
    // affiliation. The field validation applies to them exactly as it does to
    // the owner — being an organizer is permission to fix a typo, not permission
    // to put arbitrary data in a public document.
    //
    // Deliberately no get() on users/{uid}. A get() would read pre-batch state
    // and so break the single writeBatch that saves the profile and publishes
    // the name together — and it buys no confidentiality, because a user can
    // only ever publish their own name.
    match /participants_public/{uid} {
      allow read: if true;
      allow create, update: if (isOwner(uid) || isAdmin())
        && request.resource.data.keys().hasOnly(['displayName', 'affiliation',
                                                 'edition', 'updatedAt'])
        && str(request.resource.data.displayName, 80)
        && optStr(request.resource.data, 'affiliation', 120)
        && request.resource.data.edition is string;
      allow delete: if isOwner(uid) || isAdmin();
    }

    // ONE abstract per participant, and the document id IS their uid. That is
    // what makes the limit real rather than advisory: there is no second slot to
    // create, so no rule has to count anything, and Firestore rules cannot count
    // documents anyway. The ownerUid field stays because the admin console joins
    // submitter details on it and the delete callable queries it.
    //
    // `list` is admins only. A participant reads their own with a direct get, so
    // there is nothing a query would buy them except a route into everybody
    // else's submissions.
    match /abstracts/{uid} {
      allow get: if isOwner(uid) || isAdmin();
      allow list: if isAdmin();

      // Register first, then submit: a confirmed address, the owner, and an open
      // window. Verification is the gate the site's flow is built around —
      // submit.html will not even mount the form without it — and it is checked
      // here because the UI is not an authorization boundary.
      //
      // Institutional mail filters do quarantine the verification message often
      // enough to matter (measured, see the README), so every page that can hit
      // this rule carries a resend button rather than leaving people stuck.
      allow create: if isVerified() && submissionWindowOpen()
        && isOwner(uid)
        && validAbstract(request.resource.data, uid)
        && request.resource.data.status == 'submitted';

      // Frozen on acceptance ONLY. An edit after acceptance would leave
      // abstracts_public stale. A rejected abstract stays editable — with one
      // slot per person, freezing it would mean a rejected participant could
      // never revise, delete, or replace their submission.
      //
      // 'withdrawn' is a retired status kept here on purpose. Nothing writes it
      // any more (the admin's Withdraw button became Return to review, which
      // writes 'submitted'), but a document from before the change still holds
      // it, and dropping it from this list would freeze that document out of
      // its owner's hands forever. Only the PREVIOUS status is tolerated; the
      // line below still pins what may be written.
      allow update: if isVerified() && submissionWindowOpen()
        && isOwner(uid)
        && resource.data.status in ['submitted', 'rejected', 'withdrawn']
        && request.resource.data.status == 'submitted'
        && validAbstract(request.resource.data, uid);

      allow delete: if isOwner(uid) && resource.data.status != 'accepted';

      allow write: if isAdmin();
    }

    // Admin-only decisions. A separate document precisely because rules cannot
    // hide a field from a document's owner.
    match /abstract_reviews/{abstractId} {
      allow read, write: if isAdmin();
    }

    // Public projection, written by the admin console on acceptance.
    match /abstracts_public/{abstractId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Editable page copy, written from the admin console so organizers do not
    // need a GitHub account to fix a typo. A missing document is not an error:
    // the site falls back to the markdown committed under content/.
    match /pages/{slug} {
      allow read: if true;
      allow write: if isAdmin()
        && request.resource.data.keys().hasOnly(['markdown', 'updatedAt', 'updatedBy'])
        && request.resource.data.markdown is string
        && request.resource.data.markdown.size() <= 20000;
      allow delete: if isAdmin();
    }

    // The program. World-readable so the page works signed out.
    match /schedule/{itemId} {
      allow read: if true;
      allow create, update: if isAdmin() && validScheduleItem(request.resource.data);
      allow delete: if isAdmin();
    }

    // Photographs of previous editions, listed from a Dropbox folder by the
    // syncDropboxGallery callable and cached here so the public page reads
    // Firestore rather than calling a function on every visit.
    //
    // World-readable, because the archive page works signed out. Admin write
    // only, and the shape is checked: the sync writes this, but so does the
    // caption editor, and a public page renders whatever ends up here.
    match /gallery/{year} {
      allow read: if true;
      allow write: if isAdmin()
        && request.resource.data.keys().hasOnly(['year', 'folderUrl', 'photos',
                                                 'syncedAt', 'syncedBy'])
        && request.resource.data.keys().hasAll(['year', 'photos'])
        && request.resource.data.year is int
        && request.resource.data.photos is list
        && request.resource.data.photos.size() <= 200
        && optStr(request.resource.data, 'folderUrl', 500);
      allow delete: if isAdmin();
    }

    // Anything not matched above is denied.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
